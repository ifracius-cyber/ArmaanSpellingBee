# Optional: bake an ElevenLabs key into local dev builds instead of pasting it in Settings.
# Never deploy a build with this set to a public URL — anyone could read the key from the JS.
VITE_ELEVENLABS_API_KEY=

# Cloud save (Supabase project → Project Settings → API). Both are public, safe to ship.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
